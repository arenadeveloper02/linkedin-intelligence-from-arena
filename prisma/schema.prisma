// **NOTE: dont remove updatedAt in any tables **
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FetchLog {
  id        String   @id @default(cuid())
  email     String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}
